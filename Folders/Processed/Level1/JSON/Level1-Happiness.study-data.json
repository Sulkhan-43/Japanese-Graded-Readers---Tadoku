  "grammar": [
    {
      "key": "grammar:~ desu yo ne",
      "pattern": "~ desu yo ne",
      "patternSegments": [
        {
          "text": "〜ですよね"
        }
      ],
      "explanation": "Adds a friendly tag seeking agreement, like “right?” after a statement.",
      "firstPassage": 1,
      "occurrenceCount": 1
    },
    {
      "key": "grammar:donna + noun",
      "pattern": "donna + noun",
      "patternSegments": [
        {
          "text": "どんな N"
        }
      ],
      "explanation": "Use donna before a noun to ask what kind of something it is.",
      "firstPassage": 2,
      "occurrenceCount": 1
    },
    {
      "key": "grammar:~ no deshou ka",
      "pattern": "~ no deshou ka",
      "patternSegments": [
        {
          "text": "〜のでしょうか"
        }
      ],
      "explanation": "A polite wondering question, often meaning “I wonder...” or “I wonder whether...”.",
      "firstPassage": 2,
      "occurrenceCount": 1
    },
    {
      "key": "grammar:N ni kuru",
      "pattern": "N ni kuru",
      "patternSegments": [
        {
          "text": "N に "
        },
        {
          "base": "来",
          "reading": "く"
        },
        {
          "text": "る"
        }
      ],
      "explanation": "Means to come to a place; the destination is marked by ni.",
      "firstPassage": 2,
      "occurrenceCount": 4
    },
    {
      "key": "grammar:N ni N ga imashita",
      "pattern": "N ni N ga imashita",
      "patternSegments": [
        {
          "text": "N に N がいました"
        }
      ],
      "explanation": "Use ni plus ga imashita to say an animate being was at a place; imashita is the polite past form of imasu.",
      "firstPassage": 3,
      "occurrenceCount": 4
    },
    {
      "key": "grammar:i-adjective -kute",
      "pattern": "i-adjective -kute",
      "patternSegments": [
        {
          "text": "i-adjective くて"
        }
      ],
      "explanation": "Connects adjectives by changing the final i to ku and adding te.",
      "firstPassage": 4,
      "occurrenceCount": 1
    },
    {
