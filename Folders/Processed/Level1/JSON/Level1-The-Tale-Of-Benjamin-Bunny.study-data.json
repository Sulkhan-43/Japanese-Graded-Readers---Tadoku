    {
      "key": "grammar:N no N",
      "pattern": "N no N",
      "patternSegments": [
        {
          "text": "NのN"
        }
      ],
      "explanation": "Place no between two nouns to link them, often showing possession or a relationship: “Peter’s house,” “inside the basket.”",
      "firstPassage": 1,
      "occurrenceCount": 17
    },
    {
