  "grammar": [
    {
      "key": "grammar:N no N",
      "pattern": "N no N",
      "patternSegments": [
        {
          "text": "N no N"
        }
      ],
      "explanation": "Links two nouns; the first noun describes or belongs to the second, as in “the family of rabbits.”",
      "firstPassage": 1,
      "occurrenceCount": 15
    },
    {
      "key": "grammar:N ga imasu",
      "pattern": "N ga imasu",
      "patternSegments": [
        {
          "text": "N ga imasu"
        }
      ],
      "explanation": "Imasu states that a person or animal exists or is present; ga marks that subject.",
      "firstPassage": 1,
      "occurrenceCount": 2
    },
    {
      "key": "grammar:V-tai",
      "pattern": "V-tai",
      "patternSegments": [
        {
          "text": "V-tai"
        }
      ],
      "explanation": "Attach tai to the verb stem to say that someone wants to do something.",
      "firstPassage": 14,
      "occurrenceCount": 1
    },
    {
      "key": "grammar:N made",
      "pattern": "N made",
      "patternSegments": [
        {
          "text": "N made"
        }
      ],
      "explanation": "Made marks an endpoint, meaning “to” or “until.”",
      "firstPassage": 16,
      "occurrenceCount": 2
    },
    {
      "key": "grammar:N mo",
      "pattern": "N mo",
      "patternSegments": [
        {
          "text": "N mo"
        }
      ],
      "explanation": "Mo means “also” or “too,” replacing the topic marker wa in these sentences.",
      "firstPassage": 16,
      "occurrenceCount": 2
    },
    {
      "key": "grammar:V-ta kara",
      "pattern": "V-ta kara",
      "patternSegments": [
        {
          "text": "V-ta kara"
        }
      ],
      "explanation": "Kara after a past-form verb gives a reason: “because” or “so.”",
      "firstPassage": 17,
      "occurrenceCount": 2
    },
    {
      "key": "grammar:N mo + negative",
      "pattern": "N mo + negative",
      "patternSegments": [
        {
          "text": "N mo + negative"
        }
      ],
      "explanation": "Nani mo with a negative verb means “nothing” or “not anything.”",
